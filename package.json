{
  "name": "budget-tracker",
  "private": true,
  "version": "1.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false --pretty",
    "test": "node --experimental-strip-types --test test/*.test.ts scripts/test/*.test.mjs",
    "build:addon": "npm run build && rm -rf budget-server/www && cp -r dist budget-server/www",
    "prepare": "husky"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "husky": "^9.1.7",
    "playwright": "^1.49.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}